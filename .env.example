# Copy to .env (ignored by Git). Never check in credentials.
# Select the Azure CLI identity within DefaultAzureCredential for local demos.
AZURE_TOKEN_CREDENTIALS=AzureCliCredential
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
# Use the actual deployment name if it differs from the model name.
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5.4-mini
# All apps use DefaultAzureCredential with Entra ID. Run az login locally.
# No API keys are used; this file contains application configuration only.
FOUNDRY_PROJECT_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/api/projects/YOUR-PROJECT
FOUNDRY_MODEL=gpt-5.4-mini
KEEP_DEMO_AGENT=false
